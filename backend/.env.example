DJANGO_SECRET_KEY=replace-with-a-long-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=driverhub
POSTGRES_USER=driverhub
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional alternative to the POSTGRES_* variables:
# DATABASE_URL=postgresql://driverhub:replace-me@127.0.0.1:5432/driverhub
DJANGO_USE_SQLITE=False
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
